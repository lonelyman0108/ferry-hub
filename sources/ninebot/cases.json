          "Authorization": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJzYW1wbGVfdXNlciJ9.sample_redacted_signature",
          "Content-Type": "application/json"
        },
        "body": "{\"deviceId\":\"sample_device_0001\"}"
      },
      "expected": {
        "authorization": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJzYW1wbGVfdXNlciJ9.sample_redacted_signature",
        "device_id": "sample_device_0001"
      }
    }
  ]
